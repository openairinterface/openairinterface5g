  <!-- TC2: DU0 stopped (RLF), UE reestablishes on the target DU1 -->
  <testCase>
    <class>Stop_Object</class>
    <desc>Stop gNB-DU0 to trigger RLF</desc>
    <yaml_path>ci-scripts/yaml_files/5g_sa_f1_b210_ho</yaml_path>
    <node>groot</node>
    <services>oai-du0</services>
  </testCase>

  <testCase>
    <class>Custom_Command</class>
    <desc>Reestablishment with cause Other Failure (on CU)</desc>
    <node>groot</node>
    <command><![CDATA[for i in $(seq 1 30); do [ $(docker logs oai-cu 2>&1 | grep -E "Reestablishment RNTI [0-9a-f]{4} req C-RNTI [0-9a-f]{4} physCellId 0 cause Other Failure" | wc -l) -eq 1 ] && exit 0; sleep 1; done; exit 1]]></command>
  </testCase>

  <!-- On F1 loss of DU0 the CU releases the UE context, so the request falls back to RRCSetup.
       RRCSETUP is accepted until the CU keeps the context; drop "|$RRCSETUP" to require reestablishment. -->
  <testCase>
    <class>Custom_Command</class>
    <desc>Reestablishment on different DU (on CU)</desc>
    <node>groot</node>
    <command><![CDATA[REESTAB="UE [0-9]+: Re-establishment on different DU \(physCellId 0 from old cell != 1 from new DU"; RRCSETUP="NR_RRCReestablishmentRequest without UE context, fallback to RRC setup"; for i in $(seq 1 30); do docker logs oai-cu 2>&1 | grep -qE "$REESTAB|$RRCSETUP" && exit 0; sleep 1; done; exit 1]]></command>
  </testCase>

  <testCase>
    <class>Custom_Command</class>
    <desc>No other Handover triggered (on CU)</desc>
    <node>groot</node>
