  <!-- TC1: HO to the rfsim DU1 fails (T304 expiry), UE reestablishes on the source DU0 -->
  <testCase>
    <class>Custom_Command</class>
    <desc>Trigger F1 Handover to DU1</desc>
    <node>groot</node>
    <command>echo ci trigger_f1_ho | ncat 127.0.0.1 9090</command>
  </testCase>

  <testCase>
    <class>Custom_Command</class>
    <desc>HO failed, rollback to source DU0 (on CU)</desc>
    <node>groot</node>
    <command><![CDATA[for i in $(seq 1 30); do docker logs oai-cu 2>&1 | grep -qE "handover for UE [0-9]+/RNTI [0-9a-f]{4} failed, rollback to original cell" && exit 0; sleep 1; done; exit 1]]></command>
  </testCase>

  <testCase>
    <class>Custom_Command</class>
    <desc>Reestablishment with cause Handover Failure (on CU)</desc>
    <node>groot</node>
    <command>[ $(docker logs oai-cu 2>&amp;1 | grep -E "Reestablishment RNTI [0-9a-f]{4} req C-RNTI [0-9a-f]{4} physCellId 0 cause Handover Failure" | wc -l) -eq 1 ]</command>
  </testCase>

  <testCase>
    <class>Custom_Command</class>
    <desc>HO not completed (on CU)</desc>
    <node>groot</node>
    <command>[ $(docker logs oai-cu 2>&amp;1 | grep -E "handover for UE [0-9]+/RNTI [0-9a-f]{4} complete!" | wc -l) -eq 0 ]</command>
  </testCase>

